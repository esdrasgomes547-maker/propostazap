# Copie para .env e preencha antes de buildar. Sem VITE_PIX_CHAVE a tela de
# assinatura avisa que a cobrança não está configurada, em vez de mostrar um
# código PIX que não cai em conta nenhuma.

# Chave PIX que recebe as assinaturas (e-mail, celular, CPF/CNPJ ou aleatória)
VITE_PIX_CHAVE=

# Nome do recebedor como aparece no app do banco (máx. 25 caracteres, sem acento)
VITE_PIX_NOME=Orca no ZAP

# Cidade do recebedor (máx. 15 caracteres, sem acento)
VITE_PIX_CIDADE=BRASIL

# WhatsApp que recebe o comprovante e devolve o código de ativação (só dígitos, com DDI)
VITE_WHATSAPP_SUPORTE=
